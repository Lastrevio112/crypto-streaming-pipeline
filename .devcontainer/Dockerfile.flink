FROM --platform=linux/arm64 flink:2.0.0-scala_2.12-java11

USER root

ENV FLINK_VERSION=2.0.0

RUN apt-get update && apt-get install -y \
    python3 \
    python3-venv \
    python3-dev \
    build-essential \
    openjdk-11-jdk \
    wget \
    unzip \ 
 && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-arm64
ENV PATH=$JAVA_HOME/bin:$PATH

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip setuptools wheel
RUN pip install apache-flink==2.0.0

COPY requirements.txt .
RUN pip install -r requirements.txt

# Add Avro + Confluent registry JARs
RUN curl -L https://repo1.maven.org/maven2/org/apache/flink/flink-sql-avro-confluent-registry/${FLINK_VERSION}/flink-sql-avro-confluent-registry-${FLINK_VERSION}.jar \
        -o /opt/flink/lib/flink-sql-avro-confluent-registry-${FLINK_VERSION}.jar

# Add Kafka SQL Connector
RUN curl -L https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/4.0.1-2.0/flink-sql-connector-kafka-4.0.1-2.0.jar \
        -o /opt/flink/lib/flink-sql-connector-kafka-4.0.1-2.0.jar

RUN chmod -R 777 /opt/flink/lib/*.jar

COPY .devcontainer/flink-config.yaml /opt/flink/conf/config.yaml

RUN chmod 777 /opt/flink/conf/config.yaml

# Copy Java files in order to compile them as jars.
COPY src/flink/partitioners/SymbolPartitioner.java /tmp/partitioner-src/com/crypto/partitioners/SymbolPartitioner.java

COPY src/flink/UDAFs/first_and_last_value/Accumulator.java /tmp/udaf-src/com/crypto/udaf/Accumulator.java
COPY src/flink/UDAFs/first_and_last_value/BoundaryValueAggFunction.java /tmp/udaf-src/com/crypto/udaf/BoundaryValueAggFunction.java
COPY src/flink/UDAFs/first_and_last_value/FirstValueAggFunction.java /tmp/udaf-src/com/crypto/udaf/FirstValueAggFunction.java
COPY src/flink/UDAFs/first_and_last_value/LastValueAggFunction.java /tmp/udaf-src/com/crypto/udaf/LastValueAggFunction.java

COPY src/flink/UDAFs/safe_stddev_pop/StdDevAccumulator.java /tmp/udaf-src/com/crypto/udaf/StdDevAccumulator.java
COPY src/flink/UDAFs/safe_stddev_pop/StdDevPopAggFunction.java /tmp/udaf-src/com/crypto/udaf/StdDevPopAggFunction.java

RUN cd /tmp/partitioner-src && \
    javac -cp "/opt/flink/lib/*" com/crypto/partitioners/SymbolPartitioner.java && \
    jar cf /opt/flink/lib/symbol-partitioner.jar com/ && \
    rm -rf /tmp/partitioner-src

# Clean up old UDAF jars after a rebuild
RUN rm -f /opt/flink/lib/udafs.jar  

RUN cd /tmp/udaf-src && \
    javac -cp "/opt/flink/lib/*" \
        com/crypto/udaf/Accumulator.java \
        com/crypto/udaf/BoundaryValueAggFunction.java \
        com/crypto/udaf/FirstValueAggFunction.java \
        com/crypto/udaf/LastValueAggFunction.java \
        com/crypto/udaf/StdDevAccumulator.java \
        com/crypto/udaf/StdDevPopAggFunction.java &&\
    jar cf /opt/flink/lib/udafs.jar com/ && \
    rm -rf /tmp/udaf-src

USER flink